# ============================================================
# Copy to .env and fill in. Every value below is optional except
# ASSEMBLYAI_API_KEY, which is what enables the real-time voice agent.
# ============================================================

# --- Required for the voice agent -------------------------------------------
# AssemblyAI Universal-Streaming (WebSocket, ~300ms latency, end-of-turn
# detection). Free signup includes $50 of credits.
# https://www.assemblyai.com/dashboard/home
ASSEMBLYAI_API_KEY=

# --- LLM grading (one of the following) -------------------------------------
# Used to grade spoken answers and write the final summary. The app degrades
# gracefully to a built-in heuristic grader if none is set, so you can still
# demo the voice agent without an LLM key.

# Option A: NVIDIA build (key format nvapi-...) -> Nemotron 3 Ultra
NVIDIA_API_KEY=

# Option B: any OpenAI-compatible endpoint
# LLM_API_URL=https://your-endpoint.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# --- Optional: persistence ---------------------------------------------------
# MySQL. Without it the app runs fully in-memory and nothing is persisted.
# DATABASE_URL=mysql://user:password@host:3306/db

# --- Optional ----------------------------------------------------------------
# PORT=3000
